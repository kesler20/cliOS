{
  "captures": {
    "agenda": {
      "after": "## Questions and Themes",
      "at": "start",
      "file": "${VAULT}/2 Activities/Meetings/Meetings Agenda.md",
      "help": "add a question to the meetings agenda",
      "task": true
    },
    "bi": {
      "after": "# Brain Inbox",
      "at": "start",
      "file": "${VAULT}/2 Activities/Daily Notes/{date}.md",
      "help": "capture a thought into today's brain inbox",
      "task": true,
      "template": "${VAULT}/3 Resources/Templates/Daily Notes Template.md"
    },
    "sop": {
      "after": "# SOPs",
      "at": "start",
      "file": "${VAULT}/2 Activities/Daily Notes/{date}.md",
      "help": "capture an SOP idea into today's daily note",
      "task": true,
      "template": "${VAULT}/3 Resources/Templates/Daily Notes Template.md"
    },
    "study": {
      "after": "# Learning Inbox",
      "at": "end",
      "file": "${VAULT}/2 Activities/Study OS/Inbox.md",
      "help": "capture something you want to learn",
      "task": true
    }
  },
  "commands": {
    "agenda": {
      "action": {
        "id": "agenda",
        "type": "capture"
      },
      "help": "add a question to the meetings agenda"
    },
    "bi": {
      "action": {
        "id": "bi",
        "type": "capture"
      },
      "help": "capture a thought into today's brain inbox"
    },
    "clone": {
      "action": {
        "argv": [
          "git",
          "clone",
          "https://github.com/kesler20/{1}"
        ],
        "cwd": "${PROTOCOL}",
        "type": "exec"
      },
      "help": "clone kesler20/<project> into ~/protocol"
    },
    "code": {
      "action": {
        "clone": "https://github.com/kesler20/{1}",
        "root": "${PROTOCOL}",
        "type": "code"
      },
      "help": "open ~/protocol/<project> in VS Code"
    },
    "folder": {
      "action": {
        "as": "path",
        "table": "folders",
        "type": "lookup"
      },
      "help": "open a stored folder in the file explorer"
    },
    "link": {
      "action": {
        "as": "url",
        "table": "links",
        "type": "lookup"
      },
      "aliases": [
        "links"
      ],
      "help": "open a stored link in the browser"
    },
    "rm": {
      "action": {
        "tables": [
          "links",
          "folders"
        ],
        "type": "config-rm"
      },
      "help": "remove a key: cli rm link|folder <key>"
    },
    "search": {
      "action": {
        "default": "google",
        "table": "searches",
        "type": "search"
      },
      "help": "search a site: cli search [vertical] <query>"
    },
    "set": {
      "action": {
        "tables": [
          "links",
          "folders"
        ],
        "type": "config-set"
      },
      "help": "add a key: cli set link|folder <key> <value>"
    },
    "sop": {
      "action": {
        "id": "sop",
        "type": "capture"
      },
      "help": "capture an SOP idea into today's daily note"
    },
    "study": {
      "action": {
        "id": "study",
        "type": "capture"
      },
      "help": "capture something you want to learn"
    }
  },
  "folders": {
    "data-lake": "${ONEDRIVE}/3 Resources/Data Lake",
